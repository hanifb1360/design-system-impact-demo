{
  "designSystem": { "package": "@acme/ui", "entry": "packages/ui/src/index.ts" },
  "tokens": ["packages/ui/src/tokens/**/*.json", "packages/ui/src/styles/**/*.css"],
  "consumers": ["apps/checkout-legacy", "apps/barrel-consumer"],
  "ownership": { "codeowners": "CODEOWNERS" },
  "migrations": {
    "schemaVersion": 1,
    "componentProps": {
      "Button": {
        "tone": {
          "replacedBy": "variant",
          "values": { "default": "primary", "critical": "danger" }
        }
      }
    },
    "tokens": {
      "--color-critical": { "replacedBy": "--color-danger" }
    }
  }
}
